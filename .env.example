# ============================================================================
# Django OTel Observability Stack — Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your project.
# All values shown are defaults — only set what you need to override.
# ============================================================================

# --- Django Application ---
OTEL_SERVICE_NAME=django
OTEL_ENVIRONMENT=development
OTEL_APPLICATION=django-otel

# --- Database ---
POSTGRES_DB=django_otel
POSTGRES_USER=django
POSTGRES_PASSWORD=django
POSTGRES_PORT=5433

SLAVE1_DB_NAME=django_otel_slave1
SLAVE1_DB_HOST=slave1db
SLAVE1_DB_PORT=5432
SLAVE1_PORT=5434

SLAVE2_DB_NAME=django_otel_slave2
SLAVE2_DB_HOST=slave2db
SLAVE2_DB_PORT=5432
SLAVE2_PORT=5435

SLAVE3_DB_NAME=django_otel_slave3
SLAVE3_DB_HOST=slave3db
SLAVE3_DB_PORT=5432
SLAVE3_PORT=5436

# --- Connection Pooling ---
DJANGO_DB_HOST=pgbouncer
DJANGO_DB_PORT=6432
PGBOUNCER_PORT=6432

# --- Cache ---
DJANGO_REDIS_URL=redis://redis:6379/1
REDIS_PORT=6379

# --- External API ---
EXTERNAL_API_URL=http://external-api:8080/get
EXTERNAL_API_PORT=8080

# --- Web Server ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
NGINX_PORT=8001

# --- OpenTelemetry SDK (Python) ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_BATCH_DELAY_MS=2000
OTEL_BATCH_MAX_SIZE=256
OTEL_BATCH_QUEUE_SIZE=2048
OTEL_FLUSH_TIMEOUT_MS=5000

# --- OTel Collector ---
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_COLLECTOR_LOG_LEVEL=warn
TEMPO_ENDPOINT=tempo:4317

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANON_ENABLED=true
GRAFANA_ANON_ROLE=Admin

# --- Prometheus ---
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# --- Tempo ---
TEMPO_HTTP_PORT=3200
