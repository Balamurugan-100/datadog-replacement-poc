  "templating": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "hide": 0,
        "includeAll": true,
        "name": "environment",
        "query": "label_values(otel_traces_span_metrics_calls_total, deployment_environment)",
        "type": "query",
        "refresh": 1,
        "sort": 1
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "hide": 0,
        "includeAll": true,
        "name": "application",
        "query": "label_values(otel_traces_span_metrics_calls_total, application)",
        "type": "query",
        "refresh": 1,
        "sort": 1
      },
      {
        "hide": 0,
        "includeAll": true,
        "name": "status",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "OK",
            "value": "STATUS_CODE_OK"
          },
          {
            "selected": false,
            "text": "ERROR",
            "value": "STATUS_CODE_ERROR"
          },
          {
            "selected": false,
            "text": "UNSET",
            "value": "STATUS_CODE_UNSET"
          }
        ],
        "query": "STATUS_CODE_OK,STATUS_CODE_ERROR,STATUS_CODE_UNSET",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-1h",
