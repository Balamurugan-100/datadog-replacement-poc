      "title": "4. Request Instances",
      "type": "link",
      "url": "/d/request-instances/apm-request-instances"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Service",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "vector(1)",
          "instant": true,
          "legendFormat": "${service}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${service}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "noValue": "${service}"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      }
    },
    {
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "title": "Endpoint / Resource",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "vector(1)",
          "instant": true,
          "legendFormat": "${resource}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${resource}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "none",
          "noValue": "${resource}"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "title": "Traces for ${service} / ${resource}",
      "type": "row",
      "panels": []
    },
    {
      "description": "Each row is one matching span/trace for this endpoint. Click Trace ID to inspect the full waterfall (middleware, DB, cache, HTTP).",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "title": "Request instances",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 200,
          "query": "{ (resource.service.name =~ \"$service\" || span.server.address =~ \"$service\") && resource.deployment.environment =~ \"$environment\" && resource.application =~ \"$application\" && (name = \"$resource\" || span.http.route = \"$resource\" || span.db.query.summary = \"$resource\" || span.app.cache.operation = \"$resource\" || span.app.cache.resource = \"$resource\") }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "custom.width",
                "value": 280
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open waterfall for ${__value.raw}",
                    "url": "",
                    "internal": {
                      "datasourceName": "Tempo",
                      "datasourceUid": "tempo",
                      "query": {
                        "query": "${__value.raw}",
                        "queryType": "traceql"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceId"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open waterfall for ${__value.raw}",
                    "url": "",
                    "internal": {
                      "datasourceName": "Tempo",
                      "datasourceUid": "tempo",
                      "query": {
                        "query": "${__value.raw}",
                        "queryType": "traceql"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "enablePagination": true,
          "show": true
        },
        "showHeader": true
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "apm",
    "datadog",
    "traces",
    "opentelemetry"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "django",
          "value": "django"
        },
        "hide": 0,
        "label": "Service",
        "name": "service",
        "options": [
          {
            "selected": true,
            "text": "django",
            "value": "django"
          }
        ],
        "query": "django",
        "skipUrlSync": false,
        "type": "textbox"
      },
      {
        "current": {
          "selected": true,
          "text": "GET /api/products/",
          "value": "GET /api/products/"
        },
        "hide": 0,
        "label": "Endpoint / Resource",
        "name": "resource",
        "options": [
          {
            "selected": true,
            "text": "GET /api/products/",
            "value": "GET /api/products/"
          }
        ],
        "query": "GET /api/products/",
        "skipUrlSync": false,
        "type": "textbox"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "hide": 0,
        "includeAll": true,
        "name": "environment",
        "query": "label_values(otel_traces_span_metrics_calls_total, deployment_environment)",
        "type": "query",
        "refresh": 1,
        "sort": 1
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "hide": 0,
        "includeAll": true,
        "name": "application",
        "query": "label_values(otel_traces_span_metrics_calls_total, application)",
        "type": "query",
        "refresh": 1,
        "sort": 1
      },
      {
        "hide": 0,
        "includeAll": true,
        "name": "status",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "OK",
            "value": "STATUS_CODE_OK"
          },
          {
            "selected": false,
            "text": "ERROR",
            "value": "STATUS_CODE_ERROR"
          },
          {
            "selected": false,
            "text": "UNSET",
            "value": "STATUS_CODE_UNSET"
          }
        ],
        "query": "STATUS_CODE_OK,STATUS_CODE_ERROR,STATUS_CODE_UNSET",
        "type": "custom"
      },
      {
        "hide": 0,
        "name": "trace_status",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "All"
          },
          {
            "selected": false,
            "text": "Errors",
            "value": "Errors"
          }
        ],
        "query": "All,Errors",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
